APP_ENV=development
PORT=8000

# Leave MONGODB_URI empty to run on an in-memory database (demo data reseeds on every restart).
MONGODB_URI=
MONGODB_DB=painbridge

JWT_SECRET=change-me-to-a-32-byte-random-string
JWT_EXPIRES_IN=86400
CORS_ORIGINS=http://localhost:3000

# Duke AI Gateway (LiteLLM proxy). Get a key at https://dashboard.ai.duke.edu/api-keys
# Without a key, every AI feature falls back to deterministic rules.
LITELLM_TOKEN=
LITELLM_MODEL=Mistral on-site
